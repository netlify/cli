{
  "name": "cli-docs-site",
  "version": "1.0.0",
  "description": "Docs site for Netlify CLI",
  "license": "MIT",
  "author": "Netlify Inc.",
  "type": "module",
  "scripts": {
    "build": "npm run build:docs-md && npm run build:site",
    "build:docs-md": "npm run build:docs-md:gen && npm run build:docs-md:copy",
    "build:docs-md:copy": "./scripts/sync.js",
    "build:docs-md:gen": "./scripts/docs.js",
    "build:site": "astro build",
    "dev": "npm run build:docs-md:copy && astro dev",
    "preview": "npm run build:docs-md:copy && astro preview",
    "start": "npm run dev"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/starlight": "0.42.7",
    "@bugsnag/js": "9.1.0",
    "astro": "7.4.2",
    "markdown-magic": "2.6.1",
    "sharp": "0.35.5",
    "strip-ansi": "7.2.0"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.3",
    "tsx": "4.23.15"
  },
  "packageManager": "npm@11.21.1+sha512.613ccbe90044257c87713bb426251ced128ca7e9b3949b65eeb18b98445a5d441e14720c73d6ad76be86f4cf42f2f0d66efe347a9a13400ccd2f6fcfb5954385"
}
