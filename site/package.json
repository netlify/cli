{
  "name": "cli-docs-site",
  "version": "1.0.0",
  "description": "Docs site for Netlify CLI",
  "license": "MIT",
  "author": "Netlify Inc.",
  "type": "module",
  "scripts": {
    "build": "npm run build:docs-md && npm run build:site",
    "build:docs-md": "npm run build:docs-md:gen && npm run build:docs-md:copy",
    "build:docs-md:copy": "./scripts/sync.js",
    "build:docs-md:gen": "./scripts/docs.js",
    "build:site": "astro build",
    "dev": "npm run build:docs-md:copy && astro dev",
    "preview": "npm run build:docs-md:copy && astro preview",
    "start": "npm run dev"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/starlight": "0.41.10",
    "@bugsnag/js": "8.10.0",
    "astro": "7.2.9",
    "markdown-magic": "2.6.1",
    "sharp": "0.34.5",
    "strip-ansi": "7.2.0"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.0",
    "tsx": "4.23.13"
  },
  "packageManager": "npm@11.19.1+sha512.cedb312b1b7f92421a02cfb68b4194e88f8346651dacd6acc5364a25ef5309d4a32b19616a1ff8aff865e7280c0fa5c0835a99f5cd93368991e2a80ec9da75d2"
}
