{
  "name": "cli-docs-site",
  "version": "1.0.0",
  "description": "Docs site for Netlify CLI",
  "license": "MIT",
  "author": "Netlify Inc.",
  "type": "module",
  "scripts": {
    "build": "npm run build:docs-md && npm run build:site",
    "build:docs-md": "npm run build:docs-md:gen && npm run build:docs-md:copy",
    "build:docs-md:copy": "./scripts/sync.js",
    "build:docs-md:gen": "./scripts/docs.js",
    "build:site": "astro build",
    "dev": "npm run build:docs-md:copy && astro dev",
    "preview": "npm run build:docs-md:copy && astro preview",
    "start": "npm run dev"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.42.6",
    "@bugsnag/js": "8.10.0",
    "astro": "7.3.8",
    "markdown-magic": "2.6.1",
    "sharp": "0.35.5",
    "strip-ansi": "7.2.0"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.2",
    "tsx": "4.23.15"
  },
  "packageManager": "npm@11.21.0+sha512.668bfc2a16a63677a22dd10bb63e5800bb4d9895b82f87c22d3ce37e9cd71b6c3a3121dc7f453181d94ae6e9680ae92c593fbb986514ef08bbf5c3ba46a8af3e"
}
