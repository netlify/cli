{
  "extends": ["@tsconfig/recommended", "@tsconfig/node22"],
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "typeRoots": ["node_modules/@types", "types"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["**/__fixtures__/**", "dist/", "functions-templates/", "site/"]
}
